# Streamlit Secrets 設定例
#
# このファイルをコピーして secrets.toml を作成してください（ローカル開発用）
# Streamlit Cloud では、デプロイ後にWebインターフェースから設定します
#
# ============================================
# デモモード設定
# ============================================

# デモモード有効化（本番APIなしで動作）
DEMO_MODE = true

# デバッグモード（詳細ログ出力）
DEBUG_MODE = false

# ============================================
# 本番環境設定（フル機能版）
# ============================================
# 以下は DEMO_MODE=false の場合のみ必要

# Google Gemini API
# GEMINI_API_KEY = "your_gemini_api_key_here"

# PostgreSQL接続（本番環境）
# DATABASE_URL = "postgresql://user:password@host:port/database"

# BigQuery設定
# GCP_PROJECT_ID = "your_gcp_project_id"
# BIGQUERY_DATASET = "geo_scoring"

# LLM API（オプション）
# OPENAI_API_KEY = "your_openai_api_key"
# ANTHROPIC_API_KEY = "your_anthropic_api_key"

# 検索API（オプション）
# SERPAPI_KEY = "your_serpapi_key"
